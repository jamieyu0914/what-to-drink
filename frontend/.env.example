# AWS S3 配置
VITE_AWS_REGION=ap-northeast-1
VITE_AWS_ACCESS_KEY_ID=your_access_key_id
VITE_AWS_SECRET_ACCESS_KEY=your_secret_access_key
VITE_S3_BUCKET_NAME=your-bucket-name

# AWS Cognito 配置 (傳統方式)
VITE_COGNITO_DOMAIN=your-cognito-domain.auth.region.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your-cognito-client-id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# AWS Amplify 配置 (推薦使用)
# 注意：如果設定了以下變數，系統將優先使用 Amplify
VITE_COGNITO_USER_POOL_ID=your_user_pool_id
# VITE_COGNITO_CLIENT_ID 與上面共用
# VITE_COGNITO_DOMAIN 與上面共用
# VITE_COGNITO_REDIRECT_URI 與上面共用
