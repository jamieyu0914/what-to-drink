# AWS Cognito 設定範例
# 複製此檔案為 .env.local 並填入實際的值

# Cognito User Pool Domain
# 格式：your-domain.auth.region.amazoncognito.com
VITE_COGNITO_DOMAIN=your-cognito-domain.auth.region.amazoncognito.com

# Cognito App Client ID
VITE_COGNITO_CLIENT_ID=your-cognito-client-id

# 登入成功後的重定向 URI (可選，預設為當前網域)
VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# AWS S3 設定 (如果需要)
VITE_S3_BUCKET_NAME=your-s3-bucket-name
VITE_AWS_REGION=us-east-1
VITE_COGNITO_IDENTITY_POOL_ID=your-identity-pool-id
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_EVENT_SLUG=your-event-slug